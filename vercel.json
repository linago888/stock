{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "data/*.gz" }
    },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/sitca/(?<action>[^/]+)", "dest": "/api/sitca.py?action=$action" },
    { "src": "/api/signals/(?<action>[^/]+)", "dest": "/api/signals.py?action=$action" },
    { "src": "/api/(?<fn>[a-zA-Z0-9_-]+)", "dest": "/api/$fn.py" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
